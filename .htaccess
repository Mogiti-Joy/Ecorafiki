# Caching and compression for Apache / cPanel hosting (Cloudflare Pages and Netlify use _headers instead)

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages: short cache so edits show up within minutes
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # CSS, JS and videos are linked with ?v=N: bump N when they change
  <FilesMatch "\.(css|js|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpe?g|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
  </FilesMatch>

  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
</IfModule>
